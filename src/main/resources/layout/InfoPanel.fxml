<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../style/info_panel.css" fx:controller="wtf.choco.aftershock.controller.InfoPanelController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>

  <Label text="%ui.replay.header.title" styleClass="header">
    <VBox.margin>
      <Insets bottom="8.0" />
    </VBox.margin>
  </Label>

  <GridPane hgap="15.0">
    <columnConstraints>
      <ColumnConstraints />
      <ColumnConstraints hgrow="ALWAYS" />
    </columnConstraints>

    <rowConstraints>
      <RowConstraints prefHeight="20.0" />
      <RowConstraints prefHeight="20.0" />
    </rowConstraints>

    <Label text="%ui.replay.header.name" styleClass="topLevelInfoLabel" />
    <Label fx:id="replayName" text="Example Title" GridPane.columnIndex="1" styleClass="topLevelInfo" />

    <Label text="%ui.replay.header.id" GridPane.rowIndex="1" styleClass="topLevelInfoLabel" />
    <Label fx:id="replayId" text="replay_placeholder_id.replay" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="topLevelInfo" />
  </GridPane>

  <Label fx:id="blueHeader" text="%ui.replay.stats.team.blue" styleClass="header, blueTeam">
    <VBox.margin>
      <Insets top="30.0" bottom="10.0" />
    </VBox.margin>
  </Label>

  <GridPane fx:id="blueGrid">
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints hgrow="ALWAYS" />
    </columnConstraints>

    <rowConstraints>
      <RowConstraints prefHeight="20.0" />
      <RowConstraints prefHeight="20.0" />
      <RowConstraints prefHeight="20.0" />
      <RowConstraints prefHeight="20.0" />
    </rowConstraints>

    <Label text="%ui.replay.stats.player" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="subheader,blueTeamDark" />
    <Label text="%ui.replay.stats.score" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="subheader,blueTeamDark" />
    <Label text="%ui.replay.stats.goals" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="subheader,blueTeamDark" />
    <Label text="%ui.replay.stats.assists" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="subheader,blueTeamDark" />
    <Label text="%ui.replay.stats.saves" GridPane.columnIndex="4" GridPane.rowIndex="0" styleClass="subheader,blueTeamDark" />
    <Label text="%ui.replay.stats.shots" GridPane.columnIndex="5" GridPane.rowIndex="0" styleClass="subheader,blueTeamDark" />

    <Label fx:id="bluePlayerOne" text="\%unknown_player%" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="blueTeamDark" />
    <Label fx:id="bluePlayerOneScore" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="blueTeam" />
    <Label fx:id="bluePlayerOneGoals" text="N/A" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="blueTeam" />
    <Label fx:id="bluePlayerOneAssists" text="N/A" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="blueTeam" />
    <Label fx:id="bluePlayerOneSaves" text="N/A" GridPane.columnIndex="4" GridPane.rowIndex="1" styleClass="blueTeam" />
    <Label fx:id="bluePlayerOneShots" text="N/A" GridPane.columnIndex="5" GridPane.rowIndex="1" styleClass="blueTeam" />

    <Label fx:id="bluePlayerTwo" text="\%unknown_player%" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="blueTeamDark" />
    <Label fx:id="bluePlayerTwoScore" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="blueTeam" />
    <Label fx:id="bluePlayerTwoGoals" text="N/A" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="blueTeam" />
    <Label fx:id="bluePlayerTwoAssists" text="N/A" GridPane.columnIndex="3" GridPane.rowIndex="2" styleClass="blueTeam" />
    <Label fx:id="bluePlayerTwoSaves" text="N/A" GridPane.columnIndex="4" GridPane.rowIndex="2" styleClass="blueTeam" />
    <Label fx:id="bluePlayerTwoShots" text="N/A" GridPane.columnIndex="5" GridPane.rowIndex="2" styleClass="blueTeam" />

    <Label fx:id="bluePlayerThree" text="\%unknown_player%" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="blueTeamDark" />
    <Label fx:id="bluePlayerThreeScore" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="blueTeam" />
    <Label fx:id="bluePlayerThreeGoals" text="N/A" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="blueTeam" />
    <Label fx:id="bluePlayerThreeAssists" text="N/A" GridPane.columnIndex="3" GridPane.rowIndex="3" styleClass="blueTeam" />
    <Label fx:id="bluePlayerThreeSaves" text="N/A" GridPane.columnIndex="4" GridPane.rowIndex="3" styleClass="blueTeam" />
    <Label fx:id="bluePlayerThreeShots" text="N/A" GridPane.columnIndex="5" GridPane.rowIndex="3" styleClass="blueTeam" />
  </GridPane>

  <Label fx:id="orangeHeader" text="%ui.replay.stats.team.orange" styleClass="header,orangeTeam">
      <VBox.margin>
         <Insets top="20.0" bottom="10.0" />
      </VBox.margin>
  </Label>

  <GridPane fx:id="orangeGrid">
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints hgrow="ALWAYS" />
    </columnConstraints>

    <rowConstraints>
      <RowConstraints prefHeight="20.0" />
      <RowConstraints prefHeight="20.0" />
      <RowConstraints prefHeight="20.0" />
      <RowConstraints prefHeight="20.0" />
    </rowConstraints>

    <Label text="%ui.replay.stats.player" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="subheader,orangeTeamDark" />
    <Label text="%ui.replay.stats.score" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="subheader,orangeTeamDark" />
    <Label text="%ui.replay.stats.goals" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="subheader,orangeTeamDark" />
    <Label text="%ui.replay.stats.assists" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="subheader,orangeTeamDark" />
    <Label text="%ui.replay.stats.saves" GridPane.columnIndex="4" GridPane.rowIndex="0" styleClass="subheader,orangeTeamDark" />
    <Label text="%ui.replay.stats.shots" GridPane.columnIndex="5" GridPane.rowIndex="0" styleClass="subheader,orangeTeamDark" />

    <Label fx:id="orangePlayerOne" text="\%unknown_player%" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="orangeTeamDark" />
    <Label fx:id="orangePlayerOneScore" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerOneGoals" text="N/A" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerOneAssists" text="N/A" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerOneSaves" text="N/A" GridPane.columnIndex="4" GridPane.rowIndex="1" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerOneShots" text="N/A" GridPane.columnIndex="5" GridPane.rowIndex="1" styleClass="orangeTeam" />
    
    <Label fx:id="orangePlayerTwo" text="\%unknown_player%" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="orangeTeamDark" />
    <Label fx:id="orangePlayerTwoScore" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerTwoGoals" text="N/A" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerTwoAssists" text="N/A" GridPane.columnIndex="3" GridPane.rowIndex="2" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerTwoSaves" text="N/A" GridPane.columnIndex="4" GridPane.rowIndex="2" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerTwoShots" text="N/A" GridPane.columnIndex="5" GridPane.rowIndex="2" styleClass="orangeTeam" />
    
    <Label fx:id="orangePlayerThree" text="\%unknown_player%" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="orangeTeamDark" />
    <Label fx:id="orangePlayerThreeScore" text="N/A" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerThreeGoals" text="N/A" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerThreeAssists" text="N/A" GridPane.columnIndex="3" GridPane.rowIndex="3" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerThreeSaves" text="N/A" GridPane.columnIndex="4" GridPane.rowIndex="3" styleClass="orangeTeam" />
    <Label fx:id="orangePlayerThreeShots" text="N/A" GridPane.columnIndex="5" GridPane.rowIndex="3" styleClass="orangeTeam" />
  </GridPane>

  <Label text="%ui.replay.goals.timeline" styleClass="header">
    <VBox.margin>
      <Insets top="20.0" bottom="10" />
    </VBox.margin>
  </Label>

  <GridPane fx:id="goalGrid" hgap="15.0" vgap="5">
    <columnConstraints>
      <ColumnConstraints />
      <ColumnConstraints hgrow="ALWAYS" />
    </columnConstraints>
    <rowConstraints>
      <RowConstraints />
    </rowConstraints>

    <Label text="%ui.replay.goals.time" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="subheader" />
    <Label text="%ui.replay.stats.player" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="subheader" />
  </GridPane>
</VBox>
